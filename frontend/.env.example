# Copy this file to `.env` and fill in real values — `.env` itself is
# git-ignored and must never be committed.
# Vite only exposes variables prefixed with VITE_ to client-side code.

# Required. Base URL of the backend API. The app throws at import time
# (see src/config.ts) if this is missing.
VITE_API_BASE_URL=http://localhost:8000
