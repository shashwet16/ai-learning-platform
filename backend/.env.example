# Copy this file to `.env` and fill in real values — `.env` itself is
# git-ignored and must never be committed.

# Required. One of: development, staging, production. No default on
# purpose — the app refuses to start if this is missing so a deployment can
# never silently run as the wrong environment.
ENVIRONMENT=development

# Required. SQLAlchemy connection string for the Postgres instance.
# No default — the app can't run at all without a database.
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/ai_learning_platform

# Required. Secret key used to sign JWT access tokens. No default — must
# never silently fall back to a shared/known value. Generate a real one
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=changeme-generate-a-real-secret-for-local-dev

# Optional — access token lifetime in minutes. Defaults to 30 if unset.
# JWT_EXPIRE_MINUTES=30

# Optional — human-readable name shown in the API docs title.
# Defaults to "AI Engineering Learning Platform API" if unset.
# APP_NAME=AI Engineering Learning Platform API

# Optional until the chat feature is used (MistralProvider fails fast at
# instantiation if this is missing, but the app itself still starts
# without it). Get a free key at https://console.mistral.ai
# MISTRAL_API_KEY=your-key-here
